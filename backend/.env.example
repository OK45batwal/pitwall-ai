# Database
DATABASE_URL=postgresql+psycopg://pitwall:pitwall@localhost:5432/pitwall_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — MUST be set in production
JWT_SECRET=change-me-in-production-use-strong-random-value

# API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# OpenF1 — historical data is free, real-time needs paid subscription
OPENF1_USERNAME=
OPENF1_PASSWORD=
